{
    "name": "turbo/php-ffmpeg",
    "type": "library",
    "description": "基于php-ffmpeg/php-ffmpeg，增加一些功能和支持m3u8",
    "keywords": [
        "video processing",
        "video",
        "audio processing",
        "audio",
        "avconv",
        "ffmpeg",
        "avprobe",
        "ffprobe"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Neutron",
            "email": "imprec@gmail.com",
            "homepage": "http://www.lickmychip.com/"
        },
        {
            "name": "Phraseanet Team",
            "email": "info@alchemy.fr",
            "homepage": "http://www.phraseanet.com/"
        },
        {
            "name": "Patrik Karisch",
            "email": "patrik@karisch.guru",
            "homepage": "http://www.karisch.guru"
        },
        {
            "name": "Romain Biard",
            "email": "romain.biard@gmail.com",
            "homepage": "https://www.strime.io/"
        },
        {
            "name": "Jens Hausdorf",
            "email": "hello@jens-hausdorf.de",
            "homepage": "https://jens-hausdorf.de"
        },
        {
            "name": "turbo",
            "email": "turbojia@163.com",
            "homepage": "http://turboblog.cn"
        }
    ],
    "require": {
        "php": ">=7.4 <8.5",
        "alchemy/binary-driver": "^5.2",
        "doctrine/cache": "^1.13",
        "evenement/evenement": "^3.0",
        "neutron/temporary-filesystem": "^3.0.1",
        "symfony/process": "^5.4"
    },
    "suggest": {
        "php-ffmpeg/extras": "A compilation of common audio & video drivers for PHP-FFMpeg",
        "silex/silex": "Only needed for the legacy Silex 1 service provider; excluded from the PHP 7.4–8.4 test matrix."
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-0": {
            "FFMpeg": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\FFMpeg\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:functional": "phpunit --testsuite functional"
    }
}
